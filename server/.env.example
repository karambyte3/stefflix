# Port the server listens on (on all network interfaces).
PORT=3000

# Media folders - absolute paths. Several folders per type are separated by ";".
# Forward slashes or backslashes both work on Windows.
#   Movies: Movies/Title (Year)/Title (Year).mp4  or  Movies/Title (Year).mp4
#   Series: Series/Show Name/Season 01/Show Name S01E02.mkv  (1x02 and s01e02 also work)
#   Videos: any file; the first sub folder is the category
MEDIA_MOVIES=D:/Media/Movies
MEDIA_SERIES=D:/Media/Series
MEDIA_VIDEOS=D:/Media/Videos;E:/Phone Videos

# New, renamed and removed files are picked up automatically (the folders are watched).
# Set to false to scan only on startup and from Settings -> "Scan library".
# WATCH_FOLDERS=true

# Optional: full path to ffprobe.exe if FFmpeg is installed but not on PATH.
# Without ffprobe the app works, but has no duration / codec info.
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Optional: full path to ffmpeg.exe (default: next to FFPROBE_PATH, or on PATH).
# Used to extract subtitles embedded in MKV/MP4 files; without it only external .srt/.vtt work.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Optional: preview thumbnails for seeking in the player (needs ffmpeg). By default they are made
# when a movie/episode is first opened (~30 s for 1080p); "all" prepares the whole library after each scan.
# STORYBOARDS=all

# Optional: folder for the database (data/) and the caches (cache/). Default: the server folder.
# The desktop app sets it to %APPDATA%\Stefflix.
# DATA_DIR=

# Optional: where the SQLite database lives (default: <DATA_DIR>/data/homestream.db)
# DB_FILE=

# TMDB (movie/series info, posters, cast). Either the "API Key" or the
# "API Read Access Token" from https://www.themoviedb.org/settings/api works.
# Without it, titles come from the file names and posters are generated.
TMDB_API_KEY=

# OpenSubtitles.com - "Search online" (yellow button) in the TV player. Free:
#   1. Create an account at https://www.opensubtitles.com
#   2. Create an API consumer at https://www.opensubtitles.com/consumers -> copy the API key
# Username/password are optional, but without them the daily download limit is very low.
# Downloaded subtitles are saved next to the video, e.g. "Movie.bg.opensubtitles-123456.srt".
OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=
